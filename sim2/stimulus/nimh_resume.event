# ./sim_top.sh 0 --auto --udp 28070 --events stimulus/nimh_resume.event > log0
# Image: images/nimh.bin ec9d1d4243df627315ff9006a17d5fc6
# No "Fake fast memory"

300 b1 3 # Attempt to quit copyright screen
320 b1 3 # Attempt to quit copyright screen
355 b1 3 # Attempt to quit copyright screen
373 b1 3 # Attempt to quit copyright screen
460 b1 3 # Attempt to quit copyright screen
670 b1 3 # Attempt to quit copyright screen
814 b1 3 # Attempt to quit copyright screen

# Select Timmys medicine chapter
931 analog 120 -2
948 analog 0 0
950 b1 3

1012 b1 3 # Open PBC wrong button
1018 b2 3 # Open PBC correct button
1024 analog 115 -7 # Move cursor to pause
1030 analog 0 0
1031 b1 3 # Press pause
1081 b1 3 # Resume

